<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="広告クローザー（試作 v2.39）"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="① ユーザー補助の設定を開く" />

        <Button
            android:id="@+id/btnOverlayPerm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="② ほかのアプリの上に表示する許可" />

        <Button
            android:id="@+id/btnOverlayToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="フローティングボタンの表示／非表示" />

        <Switch
            android:id="@+id/swMaster"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="全体オン" />

        <Switch
            android:id="@+id/swResident"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="常駐待機（広告を自動で検知する）" />

        <Switch
            android:id="@+id/swPatternA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="パターンA（右上・「報酬を獲得しました」）" />

        <Switch
            android:id="@+id/swPatternB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="パターンB/C（左上・時間で判定）" />

        <Switch
            android:id="@+id/swStore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ストアからの復帰処理" />

        <Switch
            android:id="@+id/swFarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="周回モード（武器選択・確認を自動で押す）" />

        <TextView
            android:id="@+id/targetsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnPickTargets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="対象アプリを選ぶ" />

        <Button
            android:id="@+id/btnAddLast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="近道：直前に使っていたアプリを追加" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="オートクリッカー設定"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="マト（連打する場所）はフローティングボタンの「連打の場所指定」から出してドラッグで合わせます。位置は保存されます。連打中はマトがタップを邪魔しないよう自動で素通り状態になります。" />

        <Switch
            android:id="@+id/swClickerMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="指定方法：回/秒で指定（オフにすると間隔msで指定）" />

        <TextView
            android:id="@+id/clickerLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekClicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/jitterLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekJitter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <TextView
            android:id="@+id/limitLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="60" />

        <TextView
            android:id="@+id/guardLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="15sp" />

        <SeekBar
            android:id="@+id/seekGuard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="50" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="使い方：①と②を設定したら、セルサバイバーで広告を見るだけです。常駐待機が広告を検知して、終わったら×を押します。検知できないときは、フローティングボタンの「広告開始」を広告を始めるタイミングで押してください。\n\n安全のため、広告処理で押す場所は画面の隅（右上・左上・ストアの×）だけに限定しています。\n\n対象アプリ（v2.0〜）：広告を閉じる対象は、セルサバイバー＋「対象アプリを選ぶ」でチェックしたアプリだけです。一度チェックすれば保存され、次回からそのまま動きます。「近道」ボタンは、直前に開いていたアプリをそのまま対象に追加します。周回モードはセルサバイバー専用で、広がりません。

周回モード（v0.8〜）：オンの間だけ、セルサバイバーの周回中に止まる画面を色で判別して自動で押します。戦闘中は敵の移動速度が×2になっていない時だけ、左上のアイコンを押して×2にします。対象は「ステータス強化（いちばん強い色のカード。同色は真ん中優先）」「ルーレットの確認→空白をタップ」「勝利の確認」だけです。ステージ選択では何も押さず、バトル開始は手動のままです。フローティングボタンの「周回開始／周回停止」からも切り替えできます。"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="動作ログ"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRefreshLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ログを更新" />

        <Button
            android:id="@+id/btnClearLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ログを消す" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
